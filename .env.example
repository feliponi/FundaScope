# Supabase project URL — shared by frontend and admin script
SUPABASE_URL=

# Anon (public) key — used by the frontend (safe to expose in the browser)
# Found in: Supabase Dashboard → Project Settings → API → anon / public
SUPABASE_ANON_KEY=

# Service role key — used ONLY by the admin Python script (never expose to the browser)
# Found in: Supabase Dashboard → Project Settings → API → service_role / secret
SUPABASE_SERVICE_ROLE_KEY=
